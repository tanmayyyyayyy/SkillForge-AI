# ==============================================================================
# SkillForge AI — Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# NEVER commit populated .env files with production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Network Configuration (Backend Express API)
# ------------------------------------------------------------------------------
# Port to listen on. Default: 5001 (cloud platforms like Render/Railway set this dynamically).
PORT=5001

# Host network interface binding. Default: 0.0.0.0 (binds to all interfaces for container/cloud compatibility).
HOST=0.0.0.0

# Runtime environment ('development' | 'production').
NODE_ENV=development

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# Secret key used for signing JWT authentication tokens.
# REQUIRED for production: Generate a random 64-character secret.
# Dev fallback: skillforge-dev-secret-key-saarthix-mvp-2026
JWT_SECRET=skillforge-dev-secret-key-saarthix-mvp-2026

# Allowed frontend origins for CORS.
# Comma-separated list of allowed URLs (e.g., https://skillforge-ai.vercel.app,https://mycustomdomain.com).
# In development or if left blank, requests from all origins/localhost are allowed.
# CLIENT_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# Database Persistence (Transactional JSON Store)
# ------------------------------------------------------------------------------
# File path for the JSON database store.
# Default: server/db/data.json
# For cloud deployments (e.g., Render Persistent Disk), point this to your mounted disk path:
# SKILLFORGE_DB_FILE=/var/data/skillforge/data.json

# ------------------------------------------------------------------------------
# AI Provider (Optional)
# ------------------------------------------------------------------------------
# Google Gemini API key for live AI Career Coach and Resume/JD enhancements.
# OPTIONAL: If omitted, SkillForge AI automatically uses its high-fidelity Contextual
# Deterministic Advisory Engine, which requires no external API keys and runs 100% offline.
# GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Frontend Client-Side Configuration (Vite)
# ------------------------------------------------------------------------------
# API base URL for the frontend client.
# Default: /api (works with Vite proxy in dev and when Express serves the frontend in prod).
# If the frontend is hosted on a separate service (e.g., Vercel) pointing to an external backend:
# VITE_API_BASE_URL=https://skillforge-api.onrender.com/api

# ------------------------------------------------------------------------------
# Feature Limits & Rate Limiting (Optional Overrides)
# ------------------------------------------------------------------------------
# Maximum accepted resume upload size in bytes (default: 5242880 = 5 MB).
# RESUME_MAX_BYTES=5242880

# Maximum characters accepted by Job Description Analyzer (default: 20000).
# JD_MAX_CHARS=20000
